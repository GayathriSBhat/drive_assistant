# Google Maps Platform key: enable Places API (New); optionally Routes API (live traffic) and Maps Grounding Lite
GOOGLE_PLACES_API_KEY=
# Gemini API key from https://aistudio.google.com/apikey (GEMINI_API_KEY also works)
GOOGLE_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# GEMINI_VOICE=Puck

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# URL the browser should use if different from LIVEKIT_URL (e.g. wss://… when testing on a phone)
# LIVEKIT_PUBLIC_URL=

API_BASE=http://localhost:8000

# Crowd-sourced "road blocked" photo reports (off for now)
ENABLE_ROAD_REPORTS=false

# Optional: Singapore LTA DataMall key — live car-park counts for malls/attractions (HDB data needs no key)
# LTA_ACCOUNT_KEY=
